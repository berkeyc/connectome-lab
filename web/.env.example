# Optional: turn on accounts (sign in by email link, saved runs, community uploads).
# Create a Supabase project, apply ../supabase/migrations, then copy the project URL
# and the public anon (publishable) key here. Never put the service role key in the web app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical URL for sitemap and social cards
NEXT_PUBLIC_SITE_URL=https://connectome-lab-gamma.vercel.app
